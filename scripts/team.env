# Team IP plan - every script reads this file.
# If DHCP gives a Mac a new address, fix it everywhere with:
#   scripts/retarget_ip.sh <old-ip> <new-ip>
MAC1_IP=10.7.23.224     # Aaryan     - primary DNS (dnsmasq) + client + Wireshark
MAC2_IP=10.7.11.1      # Vivek      - primary edge (nginx, TLS, load balancer)
MAC3_IP=10.7.4.180     # Pratik     - Backend A :3001 + BACKUP DNS (Ext A)
MAC4_IP=10.7.13.204     # Raghvendra - Backend B :3002 + STANDBY edge (Ext E) + client

# Phase 2 roles (swap these two lines if a managed Mac cannot run the service)
BACKUP_DNS_IP=$MAC4_IP      # Extension A (moved from Mac 3: managed Mac, firewall locked)
STANDBY_EDGE_IP=$MAC4_IP    # Extension E

DOMAIN=app.team1.test
PORT_A=3001
PORT_B=3002
